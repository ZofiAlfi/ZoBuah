# ===== Environment untuk development (jangan pakai value ini di production) =====
DEBUG=True
SECRET_KEY=ganti-dengan-random-string-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+psycopg2://fruitpos:fruitpos@localhost:5432/fruitpos
UPLOAD_DIR=./uploads

# ===== Storage foto =====
# "local" = simpan di disk (dev). "s3" = Backblaze B2 / S3-compatible (production).
# Note: bucket B2 TIDAK perlu publik; API mem-proxy lewat /uploads.
STORAGE=local
# Baris berikut hanya dibutuhkan jika STORAGE=s3:
S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
S3_ACCESS_KEY_ID=<Backblaze KeyID>
S3_SECRET_ACCESS_KEY=<Backblaze ApplicationKey>
S3_BUCKET=<nama-bucket>

# ===== Docker Compose variable =====
DB_PASSWORD=fruitpos